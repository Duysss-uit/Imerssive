   "combine_embeds": "concat", "start_at": 0, "end_at": 0.7, "embeds_scaling": "V only"}},
 "14": {"class_type": "IPAdapterAdvanced", "inputs": {"model": ["13", 0], "ipadapter": ["10", 1], "image": ["12", 0], "weight": 0.25, "weight_type": "ease in-out",
   "combine_embeds": "concat", "start_at": 0, "end_at": 0.7, "embeds_scaling": "V only"}},
 "5": {"class_type": "EmptyLatentImage", "inputs": {"width": "{width}", "height": "{height}", "batch_size": 1}},
