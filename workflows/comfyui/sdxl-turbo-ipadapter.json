 "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{negative}", "clip": ["4", 1]}},
 "3": {"class_type": "KSampler", "inputs": {"seed": "{seed}", "steps": 7, "cfg": 2, "sampler_name": "dpmpp_sde", "scheduler": "karras", "denoise": 1,
